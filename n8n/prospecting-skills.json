        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"results\"\n  ],\n  \"properties\": {\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"lead_id\",\n          \"label\",\n          \"heading\"\n        ],\n        \"properties\": {\n          \"lead_id\": {\n            \"type\": \"string\"\n          },\n          \"label\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"In\",\n              \"Out\",\n              \"Can't tell\"\n            ]\n          },\n          \"heading\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
      },
      "id": "366308e4-cc13-5168-acdc-037265313f7f",
      "name": "Qualify output",
